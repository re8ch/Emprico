{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["authority", "visibility", "publications"],
  "properties": {
    "$schema": {"type": "string"},
    "authority": {
      "type": "object",
      "required": ["data", "governance"],
      "properties": {
        "data": {"type": "string", "format": "uri"},
        "governance": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "visibility": {"enum": ["private", "public", "gated"]},
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "publishedAt", "revision", "revisionUrl", "sourcePullRequest", "files"],
        "properties": {
          "name": {"type": "string"},
          "publishedAt": {"type": "string", "format": "date-time"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "revisionUrl": {"type": "string", "format": "uri"},
          "sourcePullRequest": {"type": "string", "format": "uri"},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
